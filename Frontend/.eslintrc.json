{
  "env": { "node": true, "es2021": true },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "plugins": ["import"],
  "rules": {
    "prettier/prettier": "error",
    "import/no-unresolved": "error",
    "import/no-duplicates": "error",
    "no-unused-vars": "warn",
    "no-console": "warn"
  }
}
